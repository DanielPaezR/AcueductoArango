# PostgreSQL (en Railway se inyecta automáticamente al enlazar el servicio)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vereda

# Secreto para firmar las sesiones (genera uno con: openssl rand -base64 32)
SESSION_SECRET=cambia-esto-por-un-secreto-largo

# Superadmin inicial (solo se usa en `npm run db:seed` si no existe)
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=cambia-esta-clave
SEED_SUPERADMIN_NOMBRE=Superadministrador

# Cloudinary (fotos y facturas)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
