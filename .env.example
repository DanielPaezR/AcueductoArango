# ─── Obligatorias ───────────────────────────────────────────────
# PostgreSQL. En Railway: Variables → Add Reference → Postgres → DATABASE_URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vereda
# Secreto de sesiones, mínimo 32 caracteres aleatorios
SESSION_SECRET=cambia-esto-por-un-secreto-largo-de-32-o-mas
# Superadmin inicial (solo se usa si todavía no existe ninguno)
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=cambia-esta-clave
SEED_SUPERADMIN_NOMBRE=Superadministrador

# ─── Fotos, facturas y firmas ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Datos legales de la Junta (aparecen en /privacidad y /terminos) ──
JAC_NOMBRE=Junta de Acción Comunal de la vereda Arango
JAC_MUNICIPIO=Concepción, Antioquia
JAC_NIT=
JAC_PERSONERIA=
JAC_DIRECCION=
JAC_CORREO=
JAC_TELEFONO=
JAC_RESPONSABLE_DATOS=Presidencia de la Junta
